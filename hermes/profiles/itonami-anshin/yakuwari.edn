;; yakuwari.edn — 権限の正本（authority）。itonami.edn の :capabilities は写しで、権限を与えない。
;; 記載のない能力はすべて :blocked（fail closed）。意思決定語彙: :autonomous / :voice-required / :approval-required / :blocked。
{:yakuwari/id :itonami-anshin
 :yakuwari/project "cloud-itonami/cloud-itonami-app"
 :yakuwari/objective "wellbecoming — 不安の原因である不透明さ（何をすればいいか・誰に聞けばいいか）を減らすため、根拠のある次の一手と公的窓口の下書きを drafts/ に作る。"
 :yakuwari/created "2026-11-07"
 :yakuwari/scale {:min 1 :desired 1 :max 1}
 :yakuwari/runners [{:runner :itonami :weight 1}]
 :yakuwari/capabilities
 [{:capability :read_source :decision :autonomous
   :note "etzhayyim tate-* / kyosai / mitate / iyashi など repo 内の既存資産だけを根拠に読む"}
  {:capability :analyze_source :decision :autonomous
   :note "要約・下書き生成は murakumo rail のみ（itonami.edn :inference）"}
  {:capability :write_workspace :decision :autonomous
   :note "hermes/profiles/itonami-anshin/drafts/<domain>/ への下書きだけ"}
  {:capability :run_local_verification :decision :autonomous}
  {:capability :open_pull_request :decision :approval-required
   :note "branch → PR。merge は人間"}
  {:capability :crisis_handoff :decision :voice-required
   :note "自傷・他害・虐待・急性の医療的危機を読み取ったら下書きを止め、公的緊急窓口を示して人間に引き継ぐ"}
  {:capability :publish_external :decision :blocked
   :note "送信・投稿・公開はしない"}
  {:capability :profile_individuals :decision :blocked
   :note "個人の脆弱性を検知・追跡・評価しない（aggregate-first）"}
  {:capability :diagnose_or_advise :decision :blocked
   :note "診断・法的助言・投資助言はしない"}
  {:capability :git_push_default_branch :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked
   :note "cron は定義のみ。有効化は host 側で owner が行う"}]}
